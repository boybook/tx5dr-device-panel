[Unit]
Description=TX-5DR OLED Device Panel
After=network-online.target tx5dr-server.service
Wants=network-online.target

[Service]
Type=simple
User=tx5dr
Group=tx5dr
Nice=10
CPUWeight=20
ExecStart=/usr/bin/tx5dr-device-panel live --backend oled
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
